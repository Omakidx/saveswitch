{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saveswitch-production-web",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "routes": [
    {
      "pattern": "saveswitch.xyz",
      "custom_domain": true
    },
    {
      "pattern": "www.saveswitch.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
