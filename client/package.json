{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_SAVESWITCH_DEV_MODE=true bun --env-file=../.env.local --bun next dev -p 5173 --hostname 127.0.0.1",
    "build": "next build",
    "start": "bun --env-file=../.env.local --bun next start -p 5173",
    "lint": "eslint",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build && node scripts/strip-static-immutable-header.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.4.0",
    "axios": "^1.20.0",
    "framer-motion": "^12.43.0",
    "next": "16.3.3",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-css-modules": "^1.16.1",
    "wrangler": "^4.165.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "type": "module"
}
