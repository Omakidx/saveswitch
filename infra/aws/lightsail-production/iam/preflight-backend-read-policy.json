{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerifyCaller",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "065897469956"
        }
      }
    },
    {
      "Sid": "ReadExactStateBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": "arn:aws:s3:::saveswitch-terraform-state-065897469956"
    },
    {
      "Sid": "ListOnlyProposedStateAndLock",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::saveswitch-terraform-state-065897469956",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "lightsail-production/core.tfstate",
            "lightsail-production/core.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ReadExactStateKeyMetadataAndPolicy",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags"
      ],
      "Resource": "arn:aws:kms:us-east-1:065897469956:key/2b923daa-87c6-491d-aca2-8ecc46aef866"
    }
  ]
}
