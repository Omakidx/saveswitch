[Unit]
Description=Saveswitch PostgreSQL logical backup and off-instance copy
Requires=saveswitch-compose.service
After=saveswitch-compose.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/saveswitch/backup-postgres
TimeoutStartSec=1800
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/srv/saveswitch/postgres/backups
