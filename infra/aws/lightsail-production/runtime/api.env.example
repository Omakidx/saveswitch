# Copy to /etc/saveswitch/runtime/api.env as root:root mode 0600. This is an
# env-file, not shell source: values must be literal and not use $VAR syntax.
NODE_ENV=production
SAVESWITCH_DEV_MODE=false
PORT=5000
CLIENT_ORIGIN=https://saveswitch.xyz
GOOGLE_REDIRECT_URI=https://api.saveswitch.xyz/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
# Generate 32 random bytes encoded as unpadded base64url (43 characters).
JWT_SECRET=REPLACE
# Use the exact generated PostgreSQL password URL-encoded here.
DATABASE_URL=postgres://saveswitch_app:REPLACE_URL_ENCODED_PASSWORD@postgres:5432/saveswitch
# Docker Compose supports one single-quoted multiline PEM value.
DATABASE_SSL_CA='REPLACE_WITH_MULTILINE_PEM_CA_CERTIFICATE'
# Docker's loopback-published port forwards host traffic through this exact,
# dedicated bridge gateway. The server rejects CF-Connecting-IP from all other
# peers. Keep this synchronized with compose.yaml and verify it before cutover.
TRUSTED_PROXY_PEERS=172.30.250.1,::ffff:172.30.250.1
# Cloudinary remains the media/object provider; use one supported credential form.
CLOUDINARY_URL=REPLACE
CLOUDINARY_UPLOAD_FOLDER=saveswitch/profiles
CLOUDINARY_RESOURCE_FOLDER=saveswitch/resources
