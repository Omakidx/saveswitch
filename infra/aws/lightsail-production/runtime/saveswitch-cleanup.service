[Unit]
Description=Saveswitch expired-data cleanup job
Requires=saveswitch-compose.service
After=saveswitch-compose.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/saveswitch/runtime
ExecStart=/usr/bin/docker compose --env-file /etc/saveswitch/runtime/runtime.env run --rm --no-deps cleanup
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
