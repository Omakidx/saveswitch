# Copy to /etc/saveswitch/runtime/runtime.env as root:root mode 0600.
# Replace every REPLACE value. Do not use a tag: every image needs @sha256.
RUNTIME_DIR=/opt/saveswitch/runtime
SAVESWITCH_API_IMAGE=065897469956.dkr.ecr.us-east-1.amazonaws.com/saveswitch-production-api@sha256:REPLACE_WITH_64_HEX_CHARACTERS
POSTGRES_IMAGE=postgres:18.0-bookworm@sha256:REPLACE_WITH_64_HEX_CHARACTERS

# Created only by the separately authorized database-disk gate.
POSTGRES_DATA_DIR=/srv/saveswitch/postgres/data
POSTGRES_PASSWORD_FILE=/etc/saveswitch/runtime/postgres-password
API_ENV_FILE=/etc/saveswitch/runtime/api.env
POSTGRES_TLS_CERT_FILE=/etc/saveswitch/runtime/postgres-server.crt
POSTGRES_TLS_KEY_FILE=/etc/saveswitch/runtime/postgres-server.key
