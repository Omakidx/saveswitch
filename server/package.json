{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run dev:db && NODE_ENV=development SAVESWITCH_DEV_MODE=true CLIENT_ORIGIN=http://localhost:5173 PORT=3000 bun --env-file=../.env.local --watch src/index.ts",
    "dev:db": "bunx drizzle-kit push --config=drizzle.dev.config.ts --force",
    "start": "bun --env-file=../.env.local src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@neondatabase/serverless": "^1.1.0",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "postgres": "^3.4.9"
  }
}
